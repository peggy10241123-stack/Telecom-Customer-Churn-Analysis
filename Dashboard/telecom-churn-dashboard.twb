      <column caption='Churn Rate' datatype='real' name='[Calculation_5949458052624385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [Customer_Status] = &apos;Churned&apos;&#10;THEN [Customer_ID]&#10;END&#10;)&#10;/&#10;COUNTD([Customer_ID])' />
      </column>
      <column caption='Churn Revenue Share' datatype='real' default-format='p0.0%' name='[Calculation_5949458054414338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [Customer_Status] = &quot;Churned&quot;&#10;THEN [Total_Revenue]&#10;ELSE 0&#10;END&#10;)&#10;/ SUM([Total_Revenue])' />
      </column>
      <column caption='Tenure Bucket' datatype='string' name='[Calculation_5949458055331843]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tenure_in_Months] &lt; 6 THEN &quot;0-6 months&quot;&#10;ELSEIF [Tenure_in_Months] &lt; 12 THEN &quot;6-12 months&quot;&#10;ELSEIF [Tenure_in_Months] &lt; 24 THEN &quot;12-24 months&quot;&#10;ELSE &quot;24+ months&quot;&#10;END' />
      </column>
