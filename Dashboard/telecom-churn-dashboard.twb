                  <formatted-text>
                    <run bold='true' fontcolor='#6057a9' fontname='Tableau Regular' fontsize='12'>Insight: </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Month-to-Month customers generate </run>
