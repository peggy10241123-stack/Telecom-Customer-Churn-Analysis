            </zone>
            <zone fixed-size='292' forceUpdate='true' h='4389' id='46' is-fixed='true' type-v2='text' w='21428' x='78786' y='25333'>
              <formatted-text>
                <run fontcolor='#1b3580' fontname='Tableau Bold' fontsize='20'>Key Findings</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
