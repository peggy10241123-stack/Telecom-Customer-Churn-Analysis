          </zone>
        </zone>
        <zone h='4444' id='44' param='horz' type-v2='layout-flow' w='67786' x='1286' y='76556'>
          <zone fixed-size='39' h='4444' id='45' is-fixed='true' is-scaled='1' param='/Users/yangpeiqi/Documents/My Tableau Repository/Shapes/Telecom/lightbulb.png' type-v2='bitmap' w='3357' x='1286' y='76556'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='4444' id='46' type-v2='text' w='64429' x='4643' y='76556'>
            <formatted-text>
              <run bold='true' fontcolor='#6057a9' fontname='Tableau Regular' fontsize='12'>Strategic Takeaway:</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Æ </run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Retention efforts should be differentiated by customer segment. Prioritize </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>high-risk month-to-month customers </run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>to </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>reduce revenue leakage</run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>, strengthen </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>early lifecycle </run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>engagement to </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>prevent churn</run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>, and maintain </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>long-term</run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'> high-value customers to </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>sustain business growth</run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#d4d4d4' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='6' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f0f3fa' />
            </zone-style>
          </zone>
        </zone>
        <zone h='60889' id='51' param='vert' type-v2='layout-flow' w='27714' x='70429' y='19833'>
          <zone forceUpdate='true' h='2500' id='50' type-v2='text' w='27572' x='70500' y='19889'>
            <formatted-text>
              <run fontcolor='#ffffff' fontname='Tableau Bold' fontsize='20'>Retention Strategy</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
