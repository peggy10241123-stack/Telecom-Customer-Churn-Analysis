          <zone fixed-size='79' h='4389' id='83' is-fixed='true' param='horz' type-v2='layout-flow' w='25929' x='74285' y='25333'>
            <zone forceUpdate='true' h='4389' id='85' is-scaled='1' param='/Users/yangpeiqi/Documents/My Tableau Repository/Shapes/Telecom/search.png' type-v2='bitmap' w='4501' x='74285' y='25333'>
