      <aliases enabled='yes' />
      <column caption='Avg Monthly GB Download' datatype='integer' name='[Avg_Monthly_GB_Download]' role='measure' type='quantitative' />
      <column caption='Avg Monthly Long Distance Charges' datatype='real' name='[Avg_Monthly_Long_Distance_Charges]' role='measure' type='quantitative' />
      <column caption='Total Users' datatype='integer' name='[Calculation_6298966715154439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Customer_ID])' />
      </column>
      <column caption='High Risk Persona' datatype='string' name='[Calculation_6298967011332104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;High-Risk Customer Persona&#10;&#10;• Month-to-Month contract&#10;• Early-stage tenure (0–6 months)&#10;• High monthly charge&#10;• Competitor-related churn reasons&#10;• Higher dissatisfaction with support/service&quot;' />
      </column>
      <column caption='Churn Reason Short' datatype='string' name='[Calculation_6545120259936257]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Churn_Reason]&#10;&#10;WHEN &quot;Competitor had better devices&quot; THEN &quot;Better devices&quot;&#10;&#10;WHEN &quot;Competitor made better offer&quot; THEN &quot;Better offer&quot;&#10;&#10;WHEN &quot;Competitor offered more data&quot; THEN &quot;More data&quot;&#10;&#10;WHEN &quot;Attitude of support person&quot; THEN &quot;Support attitude&quot;&#10;&#10;WHEN &quot;Attitude of service provider&quot; THEN &quot;Service quality&quot;&#10;&#10;ELSE [Churn_Reason]&#10;&#10;END' />
      </column>
      <column caption='Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_6545120896495622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Customer_Status] = &quot;Churned&quot; THEN [Customer_ID] END)&#10;/&#10;COUNTD([Customer_ID])' />
      </column>
      <column caption='AVG Revenue' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_6545120976011271]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Revenue])/COUNTD([Customer_ID])' />
      </column>
      <column caption='Churned Users' datatype='integer' name='[Calculation_6545121244016648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Customer_Status] = &quot;Churned&quot; THEN  [Customer_ID] END)' />
