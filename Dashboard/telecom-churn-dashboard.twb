          </zone>
          <zone fixed-size='1018' h='56556' id='52' is-fixed='true' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='27572' x='70500' y='22389'>
            <zone forceUpdate='true' h='18889' id='53' type-v2='text' w='27571' x='70500' y='22389'>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='15'>1. Month-to-Month Customers      </run>
                <run bold='true' fontcolor='#f28e2b' fontname='Tableau Semibold' fontsize='15'>Æ </run>
                <run bold='true' fontcolor='#e15759' fontname='Tableau Semibold' fontsize='15'>Highest Priority</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Why Prioritize?</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Highest churn rate (45.8%)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Largest revenue leakage ($2.46M)</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Recommended Actions</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='14'>• </run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Offer contract upgrade incentives</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='14'>• </run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Provide bundle discounts &amp; promotions</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='14'>• </run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Strengthen value communication</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='14'>• </run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Implement win-back campaigns</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#ff9d9a' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='6' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='18833' id='54' type-v2='text' w='27571' x='70500' y='41278'>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>2. Early Lifecycle Customers</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Bold' fontsize='15' italic='true'>(One Year Contract)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#f28e2b' fontname='Tableau Bold' fontsize='15'>High Priority</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Why Prioritize?</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Moderate churn risk (10.9%)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>High preventability in early stage</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Recommended Actions</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='14'>• </run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Improve onboarding &amp; education</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='14'>• </run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Increase early engagement</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='14'>• </run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Proactive support &amp; follow-up</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='14'>• </run>
                <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Monitor usage &amp; satisfaction</run>
