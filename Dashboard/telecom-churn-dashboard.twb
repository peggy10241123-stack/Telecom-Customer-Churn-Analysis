          </zone>
          <zone fixed-size='895' forceUpdate='true' h='4556' id='23' is-fixed='true' type-v2='text' w='64500' x='4643' y='71333'>
            <formatted-text>
              <run bold='true' fontcolor='#6057a9' fontname='Tableau Regular' fontsize='12'>Insight: </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Month-to-Month customers generate </run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>the highest churn and the largest revenue loss, while </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>long-term customers</run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='12'> have significantly higher individual customer value.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#e6e6e6' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='6' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f0f3fa' />
