        <zone h='4556' id='43' param='horz' type-v2='layout-flow' w='67857' x='1286' y='71333'>
          <zone forceUpdate='true' h='4556' id='25' is-scaled='1' param='/Users/yangpeiqi/Documents/My Tableau Repository/Shapes/Telecom/inovation.png' type-v2='bitmap' w='3357' x='1286' y='71333'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
