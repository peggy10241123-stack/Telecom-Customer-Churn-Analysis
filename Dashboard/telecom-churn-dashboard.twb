          <zone fixed-size='203' forceUpdate='true' h='11722' id='80' is-fixed='true' type-v2='text' w='25929' x='74285' y='13611'>
            <formatted-text>
              <run fontcolor='#000000' fontsize='14'>•   </run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='14'>Tenure:  0-6 months</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='14'>•   </run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='14'>Contract:  Month-to-Month</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='14'>•   </run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='14'>Monthly Charge: Medium to High($30+)</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='14'>•   </run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='14'>Churn Risk: </run>
              <run bold='true' fontcolor='#e15759' fontname='Tableau Regular' fontsize='14'>Highest(58%)</run>
